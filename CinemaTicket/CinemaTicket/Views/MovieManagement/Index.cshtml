@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<CinemaTicket.Data.Movie>
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<!--begin::App Content Header-->
<div class="app-content-header">
	<!--begin::Container-->
	<div class="container-fluid">
		<!--begin::Row-->
		<div class="row">
			<div class="col-sm-6">
				<h3 class="mb-0">Movie Management</h3>
			</div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-end">
					<li class="breadcrumb-item"><a asp-action="AdminPage" asp-controller="Admin">Home</a></li>
					<li class="breadcrumb-item active" aria-current="page">
						Movie List
					</li>
				</ol>
			</div>
		</div> <!--end::Row-->
	</div> <!--end::Container-->
</div>

<hr />
<div class="row">
	<div class="col-md-12">
		<div class="panel panel-default">
			<div class="panel-body">
				<h3>Movies List</h3>
				<a asp-action="Create"><button type="button" class="btn btn-success mb-1">Create New</button></a>
				<div class="table-responsive">
					<form asp-action="Index" role="form" method="get" class="form-inline">
						Search Movie <input type="text" name="txtSearch" value="" />
						<button type="submit" class="btn btn-primary">Search</button>
					</form>
					<select name="genreId" asp-items="@ViewData["GenreId"] as SelectList" onchange="filterMoviesByGenre(this.value)">
					</select>
					<!--Phân trang-->
					<div class="card-header">
						<div class="card-tools">
							@Html.PagedListPager(Model, page => Url.Action("Index", "MovieManagement", new { page = page }),
																new PagedListRenderOptions
							{
								LiElementClasses = new string[] { "page-item" },
								PageClasses = new string[] { "page-link" }
							})
						</div>
					</div>
					<div class="card-body p-0">
						<table class="table table-striped table-bordered table-hover" id="dataTables-example">
							<thead>
								<tr>
									<th width="110px">@Html.DisplayNameFor(model => model.First().Url)</th>
									<!--First() để xóa lỗi -->
									<th width="200px">@Html.DisplayNameFor(model => model.First().Title)</th>
									<th width="150px">@Html.DisplayNameFor(model => model.First().UpdatedAt)</th>
									<th width="150px">@Html.DisplayNameFor(model => model.First().CreatedAt)</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr class="">
										<td>
											<img width="100" src="~/images/@Html.DisplayFor(modelItem => item.Url)" alt="Poster"
												 onerror="this.src='/images/movie-placeholder.jpg'">
										</td>
										<td>@Html.DisplayFor(modelItem => item.Title)</td>
										<td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
										<td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
										<td>

											<a asp-action="Edit" asp-route-id="@item.MovieId"><Button type="button" class="btn btn-warning mb-1">Edit</Button></a> |
											<a asp-action="Details" asp-route-id="@item.MovieId"><Button tpye="button" class="btn btn-info mb-1">Details</Button></a> |
											<a asp-action="Delete" asp-route-id="@item.MovieId"><Button type="button" class="btn btn-danger mb-1">Delete</Button></a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!--End Advanced Tables -->
@section Scripts {
	<script>
		$(document).ready(function () {
			$('#dataTables-example').dataTable();
		});
	</script>

	<script>
		function filterMoviesByGenre(genreId) {
			window.location.href = '/MovieManagement/FilterByGenre?genreId=' + genreId;
		}
	</script>
}
