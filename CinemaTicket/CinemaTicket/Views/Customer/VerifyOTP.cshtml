@{
    ViewData["Title"] = "Xác minh OTP";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg p-4" style="max-width: 450px; width: 100%; border-radius: 10px;">
        <div class="text-center">
            <h3 class="mt-3 font-weight-bold text-danger">Xác minh OTP</h3>
            <p class="text-muted">Nhập OTP đã gửi đến email của bạn để đặt lại mật khẩu</p>
        </div>

        <hr />

        <!-- Hiển thị thông báo lỗi -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }

        <form asp-action="VerifyOTP" method="post">
            <!-- Email -->
            <div class="form-group">
                <label class="font-weight-bold">Email</label>
                <input type="email" name="email" class="form-control rounded-pill px-3" placeholder="Nhập email" required />
            </div>

            <!-- OTP -->
            <div class="form-group">
                <label class="font-weight-bold">Mã OTP</label>
                <input type="text" name="otp" class="form-control rounded-pill px-3 text-center" maxlength="6" placeholder="Nhập mã OTP" required />
            </div>

            <!-- Mật khẩu mới -->
            <div class="form-group">
                <label class="font-weight-bold">Mật khẩu mới</label>
                <input type="password" name="newPassword" class="form-control rounded-pill px-3" placeholder="Nhập mật khẩu mới" required />
            </div>

            <!-- Nút xác nhận -->
            <div class="text-center">
                <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill">
                    <i class="fas fa-check-circle"></i> Xác nhận
                </button>
            </div>
        </form>

        <!-- Liên kết hỗ trợ -->
        <div class="text-center mt-3">
            <small>
                <a asp-action="ForgotPassword" class="text-muted">Gửi lại OTP</a> |
                <a asp-action="DangNhap" class="text-muted">Quay lại đăng nhập</a>
            </small>
        </div>
    </div>
</div>
