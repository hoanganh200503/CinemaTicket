@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg p-4" style="max-width: 450px; width: 100%; border-radius: 10px;">
        <div class="text-center">
            <h3 class="mt-3 font-weight-bold text-danger">Quên mật khẩu</h3>
            <p class="text-muted">Nhập email của bạn để nhận mã OTP đặt lại mật khẩu</p>
        </div>

        <hr />

        <!-- Hiển thị thông báo thành công -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="ForgotPassword" method="post">
            <!-- Email -->
            <div class="form-group">
                <label class="font-weight-bold">Email</label>
                <input type="email" name="email" class="form-control rounded-pill px-3" placeholder="Nhập email" required />
            </div>

            <!-- Nút gửi OTP -->
            <div class="text-center">
                <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill">
                    <i class="fas fa-paper-plane"></i> Gửi OTP
                </button>
            </div>
        </form>

        <!-- Liên kết hỗ trợ -->
        <div class="text-center mt-3">
            <small>
                <a asp-action="DangNhap" class="text-muted">Quay lại đăng nhập</a>
            </small>
        </div>
    </div>
</div>
