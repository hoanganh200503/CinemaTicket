@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

@model CinemaTicket.Models.Customer

<!-- Hiển thị thông báo lỗi -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger text-center">@ViewBag.Error</div>
}


<!-- Container chính -->
<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg p-4" style="max-width: 380px; width: 100%; border-radius: 10px;">
        <div class="text-center">
            <h3 class="mt-1 font-weight-bold text-danger">Đăng ký tài khoản</h3>
        </div>
        <form asp-action="Dangky" method="post" style="margin-top: 1px;">
            <input type="hidden" asp-for="CustomerId" />

            <!-- Họ và tên -->
            <div class="form-group">
                <label asp-for="Name" class="font-weight-bold">Họ và Tên</label>
                <input asp-for="Name" class="form-control rounded-pill px-3" placeholder="Nhập họ và tên" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email" class="font-weight-bold">Email</label>
                <input asp-for="Email" type="email" class="form-control rounded-pill px-3" placeholder="Nhập email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="form-group">
                <label asp-for="Password" class="font-weight-bold">Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control rounded-pill px-3" placeholder="Nhập mật khẩu" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Xác nhận mật khẩu -->
            <div class="form-group">
                <label for="ConfirmPassword" class="font-weight-bold">Xác nhận mật khẩu</label>
                <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control rounded-pill px-3" placeholder="Nhập lại mật khẩu" required />
            </div>

            <!-- Ngày tạo và cập nhật -->
            <input type="hidden" asp-for="CreatedAt" value="@DateTime.Now" />
            <input type="hidden" asp-for="UpdatedAt" value="@DateTime.Now" />

            <!-- Nút đăng ký -->
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill">
                    <i class="fas fa-user-plus"></i> Đăng ký
                </button>
            </div>

        </form>

        <div class="text-center mt-2">
            <small>Đã có tài khoản? <a asp-action="DangNhap" asp-controller="Customer" >Đăng nhập</a></small>
        </div>
    </div>
</div>
