@model CinemaTicket.Data.Room
@{
    ViewData["Title"] = "Quản lý Phòng và Ghế";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Phòng: @Model.RoomName</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RoomType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RoomType)
        </dd>
    </dl>
</div>

<div class="container">
    <h2>Sơ đồ ghế</h2>
    <div class="row">
        <div class="col-md-12">
            <div class="seat-map">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            @for (int i = 1; i <= GetMaxColumn(Model.Seats); i++)
                            {
                                <th>@i</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (char row = 'A'; row <= GetMaxRow(Model.Seats); row++)
                        {
                            <tr>
                                <th>@row</th>
                                @for (int col = 1; col <= GetMaxColumn(Model.Seats); col++)
                                {
                                    var seat = Model.Seats.FirstOrDefault(s => s.SeatNumber == $"{row}{col}");
                                    if (seat != null)
                                    {
                                        <td class="seat @(seat.Status == "Occupied" ? "occupied" : "") @(seat.SeatType)">
                                            <a href="#"
                                               data-seat-id="@seat.SeatId"
                                               data-seat-number="@seat.SeatNumber"
                                               data-seat-type-id="@seat.SeatTypeId"
                                               data-status="@seat.Status"
                                               onclick="showSeatDetails(this)">
                                                @col
                                            </a>
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seatDetailsModal" tabindex="-1" role="dialog" aria-labelledby="seatDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="seatDetailsModalLabel">Chi tiết Ghế</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong>Số ghế:</strong> <span id="seatNumber"></span></p>
                <p><strong>Loại ghế:</strong> <span id="seatType"></span></p>
                <p><strong>Trạng thái:</strong> <span id="seatStatus"></span></p>

                <form id="changeSeatTypeForm">
                    <div class="form-group">
                        <label for="newSeatTypeId">Chọn loại ghế mới:</label>
                        <select class="form-control" id="newSeatTypeId" name="newSeatTypeId">
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Đổi loại ghế</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* CSS cho sơ đồ ghế */
        .seat-map {
            text-align: center;
        }

        .seat {
            width: 40px;
            height: 40px;
            display: inline-block;
            margin: 4px;
            border: 1px solid #ccc;
            text-align: center;
            line-height: 40px;
            cursor: pointer;
        }

        .seat.occupied {
            background-color: #6c757d;
            color: #fff;
        }

        .seat.Vip {
            background-color: #ffc107;
        }

        .seat.Normal {
            background-color: #007bff;
            color: #fff;
        }

        /* Thêm các kiểu ghế khác nếu cần */

        .table-bordered th,
        .table-bordered td {
            border: 1px solid #dee2e6;
        }
    </style>
}

@section Scripts {
    <script>
        // JavaScript để xử lý sự kiện click ghế và hiển thị modal
        function showSeatDetails(element) {
            var seatId = $(element).data('seat-id');
            var seatNumber = $(element).data('seat-number');
            var seatTypeId = $(element).data('seat-type-id');
            var status = $(element).data('status');

            $('#seatNumber').text(seatNumber);
            $('#seatType').text(getSeatTypeName(seatTypeId)); // Hàm này cần được định nghĩa để lấy tên loại ghế
            $('#seatStatus').text(status);

            // Gọi API để lấy danh sách loại ghế và thêm vào dropdown
            $.get('/api/SeatTypes', function (data) {
                var dropdown = $('#newSeatTypeId');
                dropdown.empty();
                $.each(data, function (index, item) {
                    dropdown.append($('<option></option>').val(item.seatTypeId).text(item.typeName));
                });
                $('#seatDetailsModal').modal('show');
            });

            // Xử lý sự kiện submit form đổi loại ghế
            $('#changeSeatTypeForm').submit(function (e) {
                e.preventDefault();
                var newSeatTypeId = $('#newSeatTypeId').val();
                // Gọi API để cập nhật loại ghế
                $.ajax({
                    url: '/api/Seats/' + seatId, // Thay đổi URL API phù hợp
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ seatId: seatId, seatTypeId: newSeatTypeId }),
                    success: function (result) {
                        $('#seatDetailsModal').modal('hide');
                        // Cập nhật lại giao diện hoặc tải lại trang
                        location.reload();
                    },
                    error: function (error) {
                        alert('Lỗi khi đổi loại ghế: ' + error.responseText);
                    }
                });
            });
        }

        // Hàm giả định để lấy tên loại ghế từ ID (Cần triển khai thực tế)
        function getSeatTypeName(seatTypeId) {
            // Logic để lấy tên loại ghế từ ID
            // Ví dụ:
            if (seatTypeId == 1) return "Normal";
            if (seatTypeId == 2) return "Vip";
            return "Không xác định";
        }

        // Hàm lấy số cột lớn nhất trong danh sách ghế
        function GetMaxColumn(seats) {
            var max = 0;
            $.each(seats, function (index, seat) {
                var col = parseInt(seat.seatNumber.substring(1));
                if (col > max) {
                    max = col;
                }
            });
            return max;
        }

        // Hàm lấy chữ cái hàng lớn nhất trong danh sách ghế
        function GetMaxRow(seats) {
            var max = 'A';
            $.each(seats, function (index, seat) {
                var row = seat.seatNumber.substring(0, 1);
                if (row > max) {
                    max = row;
                }
            });
            return max;
        }
    </script>
}