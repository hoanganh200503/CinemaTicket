@{
}
@model CinemaTicket.Models.Customer

@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<div class="container mt-4">
    <div class="row">
        <!-- Menu bên trái -->
        <div class="col-md-3">
            <div class="text-center mb-3">
                <h4>@Model.Name</h4>
                <p class="text-muted">THÀNH VIÊN TỪ @Model.CreatedAt
            </div>
            <div class="list-group">
                <a asp-action="Profile" class="list-group-item list-group-item-action">Thông tin chung</a>
                <a asp-action="Details" class="list-group-item list-group-item-action">Chi tiết tài khoản</a>
                <a href="#" class="list-group-item list-group-item-action">Lịch sử giao dịch</a>
                <a asp-action="Logout" class="list-group-item list-group-item-action text-danger">Đăng xuất</a>
            </div>
        </div>

        <!-- Form chỉnh sửa bên phải -->
        <div class="col-md-9">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">CHỈNH SỬA THÔNG TIN</h5>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input type="text" class="form-control" name="name" value="@Model.Name" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="email" value="@Model.Email" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Đổi mật khẩu?</label>
                            <select class="form-select" id="changePassword" name="changePassword" onchange="togglePasswordFields()">
                                <option value="no" selected="@(ViewData["OpenPasswordChange"] as bool? == true ? "false" : "true")">Không</option>
                                <option value="yes" selected="@(ViewData["OpenPasswordChange"] as bool? == true ? "true" : "false")">Có</option>
                            </select>

                        </div>

                        <div id="passwordFields" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label">Mật khẩu hiện tại</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" name="currentPassword" id="currentPassword">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('currentPassword')">
                                        <i class="bi bi-eye" id="currentPassword-icon"></i>
                                    </button>
                                </div>
                                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey("currentPassword"))
                                {
                                    <div class="text-danger small mt-1">
                                        @Html.ValidationMessage("currentPassword")
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mật khẩu mới</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" name="newPassword" id="newPassword">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('newPassword')">
                                        <i class="bi bi-eye" id="newPassword-icon"></i>
                                    </button>
                                </div>
                                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey("newPassword"))
                                {
                                    <div class="text-danger small mt-1">
                                        @Html.ValidationMessage("newPassword")
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                            <a asp-action="Details" class="btn btn-secondary ms-2">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ẩn thông báo thành công sau 3 giây
        document.addEventListener('DOMContentLoaded', function() {
            var successMessage = document.getElementById('successMessage');
            if (successMessage) {
                setTimeout(function() {
                    successMessage.style.display = 'none';
                }, 3000);
            }
        });

        function togglePasswordFields() {
            var changePassword = document.getElementById('changePassword');
            var passwordFields = document.getElementById('passwordFields');
            passwordFields.style.display = changePassword.value === 'yes' ? 'block' : 'none';
        }

        function togglePassword(inputId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(inputId + '-icon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        // Khi load lại trang, giữ nguyên trạng thái "Đổi mật khẩu?"
        document.addEventListener("DOMContentLoaded", function () {
            var changePasswordSelect = document.getElementById("changePassword");
            var passwordFields = document.getElementById("passwordFields");

            var isPasswordChangeSelected = "@(ViewData["OpenPasswordChange"] as bool? == true ? "yes" : "no")";

            changePasswordSelect.value = isPasswordChangeSelected;

            // Hiển thị hoặc ẩn phần nhập mật khẩu theo lựa chọn
            togglePasswordFields();
        });

    </script>
}

}