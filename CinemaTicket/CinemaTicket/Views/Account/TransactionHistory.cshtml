    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<CinemaTicket.Data.Transaction>
@* Đổi lại model CinematicketApp.Model.Customer => CinemaTicket.Data.Customer  *@
@{
    ViewData["Title"] = "Lịch sử giao dịch";
}

<div class="container mt-4">
    <div class="row">
        <!-- Menu bên trái -->
        <div class="col-md-3">
            <div class="text-center mb-3">
                <h4>@Context.Session.GetString("UserName")</h4>
                
            </div>
            <div class="list-group">
                <a asp-action="Profile" class="list-group-item list-group-item-action">Thông tin chung</a>
                <a asp-action="Details" class="list-group-item list-group-item-action">Chi tiết tài khoản</a>
                <a asp-action="TransactionHistory" class="list-group-item list-group-item-action active">Lịch sử giao dịch</a>
                <a asp-action="Logout" class="list-group-item list-group-item-action text-danger">Đăng xuất</a>
            </div>
        </div>

        <!-- Lịch sử giao dịch bên phải -->
        <div class="col-md-9">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">LỊCH SỬ GIAO DỊCH</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted">
                            <p>Bạn chưa có giao dịch nào.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã GD</th>
                                        <th>Ngày giờ</th>
                                        <th>Phương thức</th>
                                        <th>Số tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Mã vé</th>
                                        <th>Tên phim</th>
                                        <th>Suất chiếu</th>
                                        <th>Phòng chiếu</th>
                                        <th>Ghế ngồi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in Model)
                                    {
                                        foreach (var ticket in transaction.TransactionTickets)
                                        {
                                            <tr>
                                                <td>#@transaction.TransactionId</td>
                                                <td>@transaction.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@transaction.PaymentMethod</td>
                                                <td>@transaction.TotalAmount.ToString("N0") đ</td>
                                                <td>
                                                    @if (transaction.Status == "Success" || transaction.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success">@transaction.Status</span>
                                                    }
                                                    else if (transaction.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning">@transaction.Status</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@transaction.Status</span>
                                                    }
                                                </td>
                                                <td>@ticket?.TicketId</td>
                                                <td>@ticket?.Ticket.Showtime?.Movie?.Title</td>
                                                <td>@ticket?.Ticket.Showtime?.CreatedAt</td>
                                                <td>@ticket?.Ticket.Seat?.Room?.RoomName</td>
                                                <td>@ticket?.Ticket.Seat?.SeatType</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
