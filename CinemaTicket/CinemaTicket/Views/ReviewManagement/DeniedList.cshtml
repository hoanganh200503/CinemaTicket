@model IEnumerable<CinemaTicket.Data.Review>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="app-content-header">
	<!--begin::Container-->
	<div class="container-fluid">
		<!--begin::Row-->
		<div class="row">
			<div class="col-sm-6">
				<h3 class="mb-0">Reviews Management</h3>
			</div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-end">
					<li class="breadcrumb-item"><a asp-action="AdminPage" asp-controller="Admin">Home</a></li>
					<li class="breadcrumb-item"><a asp-action="Index" asp-controller="ReviewManagement">Waiting Review</a></li>
					<li class="breadcrumb-item active" aria-current="page">
						Denied reviews
					</li>
				</ol>
			</div>
		</div> <!--end::Row-->
	</div> <!--end::Container-->
</div>


<hr />
<div class="row">
	<div class="col-md-12">
		<div class="panel panel-default">
			<div class="panel-body">
				<div class="row">
					<div class="col-md-6">
						<h3>Add Movie</h3>
						<table class="table">
							<thead>
								<tr>
									<th>
										@Html.DisplayNameFor(model => model.Movie.Title)
									</th>
									<th>
										@Html.DisplayNameFor(model => model.Customer.Name)
									</th>
									<th>
										@Html.DisplayNameFor(model => model.Rating)
									</th>
									<th>
										@Html.DisplayNameFor(model => model.Comment)
									</th>
									<th>
										@Html.DisplayNameFor(model => model.IsApproved)
									</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>
											@Html.DisplayFor(modelItem => item.Movie.Title)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.Customer.Name)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.Rating)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.Comment)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.IsApproved)
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
