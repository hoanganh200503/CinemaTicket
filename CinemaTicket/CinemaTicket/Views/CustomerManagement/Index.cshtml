@model IEnumerable<CinemaTicket.Data.Customer>
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!--begin::App Content Header-->
<div class="app-content-header">
	<!--begin::Container-->
	<div class="container-fluid">
		<!--begin::Row-->
		<div class="row">
			<div class="col-sm-6">
				<h3 class="mb-0">Customer Management</h3>
			</div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-end">
					<li class="breadcrumb-item"><a href="#">Home</a></li>
					<li class="breadcrumb-item active" aria-current="page">
						Customers List
					</li>
				</ol>
			</div>
			<div class="col-sm-6">
				<a asp-action="Create"><button type="button" class="btn btn-success mb-1">Create New</button></a>
			</div>
		</div> <!--end::Row-->
		<!-- Toggle Button Row -->
		<div class="row mb-3">
			<div class="col-md-12">
				<div class="btn-group" role="group">
					<button type="button" class="btn btn-primary active" id="usersBtn">Users</button>
					<button type="button" class="btn btn-primary" id="adminsBtn">Admins</button>
				</div>
			</div>
		</div>
	</div> <!--end::Container-->
</div>
<div class="app-content">
	<!--begin::Container-->
	<div class="container-fluid">
		<!-- Info boxes -->
		<div class="row">
			<div class="col-md-12">
				<div class="panel panel-default" id="usersPanel">
					<div class="panel-heading">
						<h3 class="panel-title">Users</h3>
					</div>
					<div class="panel-body">
						<div class="table-responsive">
							<table class="table table-striped table-bordered table-hover" id="usersTable">
								<thead>
									<tr>
										<th width="200px">@Html.DisplayNameFor(model => model.Name)</th>
										<th width="150px">@Html.DisplayNameFor(model => model.UpdatedAt)</th>
										<th width="150px">@Html.DisplayNameFor(model => model.CreatedAt)</th>
										<th width="150px"></th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in Model.Where(c => c.Role == "User"))
									{
										<tr class="">
											<td>@Html.DisplayFor(modelItem => item.Name)</td>
											<td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
											<td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
											<td>
												<div class="text-center">
													<a asp-action="Edit" asp-route-id="@item.CustomerId"><Button type="button" class="btn btn-warning mb-1">Edit</Button></a> 
													<a asp-action="Details" asp-route-id="@item.CustomerId"><Button type="button" class="btn btn-info mb-1">Details</Button></a> 
													<a asp-action="Delete" asp-route-id="@item.CustomerId"><Button type="button" class="btn btn-danger mb-1">Delete</Button></a>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div class="panel panel-default" id="adminsPanel" style="display: none;">
					<div class="panel-heading">
						<h3 class="panel-title">Admins</h3>
					</div>
					<div class="panel-body">
						<div class="table-responsive">
							<table class="table table-striped table-bordered table-hover" id="adminsTable">
								<thead>
									<tr>
										<th width="200px">@Html.DisplayNameFor(model => model.Name)</th>
										<th width="150px">@Html.DisplayNameFor(model => model.UpdatedAt)</th>
										<th width="150px">@Html.DisplayNameFor(model => model.CreatedAt)</th>
										<th width="150px"></th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in Model.Where(c => c.Role == "Admin"))
									{
										<tr class="">
											<td>@Html.DisplayFor(modelItem => item.Name)</td>
											<td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
											<td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
											<td>
												<div class="text-center">
													<a asp-action="Edit" asp-route-id="@item.CustomerId"><Button type="button" class="btn btn-warning mb-1">Edit</Button></a>
													<a asp-action="Details" asp-route-id="@item.CustomerId"><Button tpye="button" class="btn btn-info mb-1">Details</Button></a>
													<a asp-action="Delete" asp-route-id="@item.CustomerId"><Button type="button" class="btn btn-danger mb-1">Delete</Button></a>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!--End Advanced Tables -->
@section Scripts {
	<script>
		$(document).ready(function () {
			// Initialize DataTables for both tables
			var usersTable = $('#usersTable').DataTable({
				paging: true,
				searching: {
					search: '',
					smart: false,
					caseInsensitive: true
				},
				columns: [
					{ searchable: true }, // Tên
					{ searchable: false }, // UpdatedAt
					{ searchable: false }, // CreatedAt
					{ searchable: false } // Cột hành động
				],
				ordering: true,
				info: true,
				responsive: true
			});

			var adminsTable = $('#adminsTable').DataTable({
				paging: true,
				searching: {
					search: '',
					smart: false,
					caseInsensitive: true
				},
				columns: [
					{ searchable: true }, // Tên
					{ searchable: false }, // UpdatedAt
					{ searchable: false }, // CreatedAt
					{ searchable: false } // Cột hành động
				],
				ordering: true,
				info: true,
				responsive: true
			});

			// Toggle between Users and Admins
			$('#usersBtn').click(function(e) {
				e.preventDefault();
				$(this).addClass('active');
				$('#adminsBtn').removeClass('active');
				$('#usersPanel').fadeIn();
				$('#adminsPanel').fadeOut();
				// Redraw the users table to ensure proper display
				usersTable.draw();
			});

			$('#adminsBtn').click(function(e) {
				e.preventDefault();
				$(this).addClass('active');
				$('#usersBtn').removeClass('active');
				$('#usersPanel').fadeOut();
				$('#adminsPanel').fadeIn();
				// Redraw the admins table to ensure proper display
				adminsTable.draw();
			});

			// Initialize the first panel
			$('#usersPanel').show();
			$('#adminsPanel').hide();
		});
	</script>
}