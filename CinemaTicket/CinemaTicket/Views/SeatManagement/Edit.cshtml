@model CinemaTicket.Models.Seat

@{
    ViewData["Title"] = "Edit Seat";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Seat</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/RoomManagement">Rooms</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-roomId="@ViewBag.RoomId">Seats</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-chair me-1"></i>
            Edit Seat
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <input type="hidden" asp-for="SeatId" />
                        <input type="hidden" asp-for="RoomId" />
                        <input type="hidden" asp-for="CreatedAt" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="SeatNumber" class="control-label"></label>
                            <input asp-for="SeatNumber" class="form-control" />
                            <span asp-validation-for="SeatNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SeatTypeId" class="control-label">Seat Type</label>
                            <select asp-for="SeatTypeId" class="form-select" asp-items="ViewBag.SeatTypeId">
                                <option value="">-- Select Seat Type --</option>
                            </select>
                            <span asp-validation-for="SeatTypeId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <div class="form-check">
                                <input asp-for="Status" class="form-check-input" />
                                <label asp-for="Status" class="form-check-label">Active</label>
                            </div>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" asp-route-roomId="@ViewBag.RoomId" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
