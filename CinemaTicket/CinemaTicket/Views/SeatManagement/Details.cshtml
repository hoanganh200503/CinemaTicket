@model CinemaTicket.Models.Seat

@{
    ViewData["Title"] = "Seat Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Seat Details</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/RoomManagement">Rooms</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-roomId="@Model.RoomId">Seats</a></li>
        <li class="breadcrumb-item active">Details</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-chair me-1"></i>
            Seat Information
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.SeatNumber)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.SeatNumber)
                        </dd>

                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Room)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Room.RoomName)
                        </dd>

                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.SeatType)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.SeatType.TypeName)
                        </dd>

                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Status)
                        </dt>
                        <dd class="col-sm-9">
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.CreatedAt)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.CreatedAt)
                        </dd>

                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.UpdatedAt)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.UpdatedAt)
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model?.SeatId" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i> Edit
                        </a>
                        <a asp-action="Index" asp-route-roomId="@Model.RoomId" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
