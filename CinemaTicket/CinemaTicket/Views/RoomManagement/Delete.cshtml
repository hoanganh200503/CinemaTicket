@model CinemaTicket.Data.Room

@{
	ViewData["Title"] = "Delete";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!--begin::App Content Header-->
<div class="app-content-header">
	<!--begin::Container-->
	<div class="container-fluid">
		<!--begin::Row-->
		<div class="row">
			<div class="col-sm-6">
				<h3 class="mb-0">Room Management</h3>
			</div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-end">
					<li class="breadcrumb-item"><a asp-action="AdminPage" asp-controller="Admin">Home</a></li>
					<li class="breadcrumb-item"><a asp-action="Index" asp-controller="RoomManagement">Room</a></li>
					<li class="breadcrumb-item active" aria-current="page">
						Delete Room
					</li>
				</ol>
			</div>
		</div> <!--end::Row-->
	</div> <!--end::Container-->
</div>


<hr />
<div class="row">
	<div class="col-md-12">
		<div class="panel panel-default">
			<div class="panel-body">
				<div class="row">
					<div class="col-md-6">
						<h3>Add Movie</h3>
						<dl class="row">
							<dt class="col-sm-2">
								@Html.DisplayNameFor(model => model.RoomName)
							</dt>
							<dd class="col-sm-10">
								@Html.DisplayFor(model => model.RoomName)
							</dd>
							<dt class="col-sm-2">
								@Html.DisplayNameFor(model => model.Cols)
							</dt>
							<dd class="col-sm-10">
								@Html.DisplayFor(model => model.Cols)
							</dd>
							<dt class="col-sm-2">
								@Html.DisplayNameFor(model => model.Rows)
							</dt>
							<dd class="col-sm-10">
								@Html.DisplayFor(model => model.Rows)
							</dd>
							<dt class="col-sm-2">
								@Html.DisplayNameFor(model => model.CreatedAt)
							</dt>
							<dd class="col-sm-10">
								@Html.DisplayFor(model => model.CreatedAt)
							</dd>
							<dt class="col-sm-2">
								@Html.DisplayNameFor(model => model.UpdatedAt)
							</dt>
							<dd class="col-sm-10">
								@Html.DisplayFor(model => model.UpdatedAt)
							</dd>
						</dl>

						<form asp-action="Delete">
							<input type="hidden" asp-for="RoomId" />
							<input type="submit" value="Delete" class="btn btn-danger" /> |
							<a asp-action="Index">Back to List</a>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
