@{
    ViewData["Title"] = "Đặt vé";
    var movie = ViewBag.Movie as CinemaTicket.Data.Movie;
}
<div class="container">
    <div class="row">
        <div class="col-md-3 mt-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold text-center">
                    🎟️ Loại & Trạng thái ghế
                </div>
                <div class="card-body">
                    <div class="seat-info">
                        <div class="seat-box vip"></div> VIP
                    </div>
                    <div class="seat-info">
                        <div class="seat-box regular"></div> Regular
                    </div>
                    <div class="seat-info">
                        <div class="seat-box couple"></div> Couple
                    </div>
                    <div class="seat-info">
                        <div class="seat-box available"></div> Available
                    </div>
                    <div class="seat-info">
                        <div class="seat-box reserved">
                            <img src="https://e1.pngegg.com/pngimages/314/988/png-clipart-symbolize-x.png" class="movie-img-note">
                        </div> Reserved
                    </div>
                    <div class="seat-info">
                        <div class="seat-box maintenance"></div> Maintenance
                    </div>
                </div>
            </div>
            <div class="card shadow-sm border-0">
                <div class="d-flex flex-column align-items-center my-4 p-4 shadow-lg bg-white rounded-3">
                    <div class="movie-poster-container mb-3">
                        <img src="@(movie?.Url ?? "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTShkml07IJkqm-kVI9W2XwnbaIUbVbKQVIPw&s")" alt="@movie.Title" class="movie-poster img-fluid rounded-3 shadow-sm">
                    </div>

                    <div class="movie-info">
                        <h2 class="fw-bold text-primary">@movie.Title</h2>
                        <p><i class="bi bi-clock-history text-warning"></i> <strong>Thời lượng:</strong> @movie.Duration phút</p>
                        <p><i class="bi bi-translate text-success"></i> <strong>Ngôn ngữ:</strong> @movie.Language</p>
                        <p><i class="bi bi-calendar3 text-danger"></i> <strong>Ngày phát hành:</strong> @movie.ReleaseDate.ToString("dd/MM/yyyy")</p>
                        <p><i class="bi bi-info-circle-fill text-secondary"></i> <strong>Mô tả:</strong> @movie.Description</p>

                        @if (movie.Genres.Any())
                        {
                            <p>
                                <i class="bi bi-tags text-info"></i> <strong>Thể loại:</strong>
                                @Html.Raw(string.Join(" ", movie.Genres.Select(g => $"<span class='badge bg-secondary'>{g.GenreName}</span>")))
                            </p>
                        }

                    </div>
                </div>

                </div>
        </div>
        <div class="col-md-9">
            <h2 class="text-center text-primary fw-bold my-4">🎬 Đặt Vé Xem Phim</h2>
    <!-- Chọn suất chiếu -->
    <div class="mb-3">
        <label for="showtimeSelect" class="form-label fw-bold">🕒 Chọn suất chiếu:</label>
        <select id="showtimeSelect" class="form-select shadow-sm">
            <option value="">🎬 Chọn suất chiếu</option>
            @foreach (var showtime in Model)
            {
                <option value="@showtime.ShowtimeId">@showtime.Showtime1</option>
            }
        </select>
    </div>

    <!-- Chọn phòng -->
    <div class="mb-3">
        <label for="roomSelect" class="form-label fw-bold">🏠 Chọn phòng:</label>
        <select id="roomSelect" class="form-select shadow-sm" disabled>
            <option value="">🏠 Chọn phòng</option>
        </select>
    </div>

    <!-- Màn hình -->
            <div class="d-flex align-items-center justify-content-center my-4 p-3 shadow-lg bg-white rounded-3">
                <div class="screen-container">
                    <div class="screen-box shadow p-3 rounded-3 bg-dark text-white text-center">
                        📽️ MÀN HÌNH 📽️
                    </div>
                </div>
            </div>

    <hr />
    <!-- Chọn ghế -->
    <div class="mb-3 text-center">
        <label class="form-label fw-bold">💺 Chọn ghế:</label>
        <div id="seatContainer" class="d-flex flex-wrap justify-content-center gap-2"></div>
    </div>
            <div class="text-center mt-3">
                <h5>Tổng tiền: <span id="totalAmount" class="fw-bold text-danger">0 đ</span></h5>
            </div>

    <!-- Nút đặt vé -->
    <div class="text-center">
        <button id="confirmBooking" class="btn btn-success fw-bold px-4 py-2" disabled>Đặt Vé</button>
    </div>
</div>
</div>
</div>
<style>
    .movie-poster {
        width: 180px;
        height: auto;
        border-radius: 10px;
        transition: transform 0.3s ease-in-out;
    }

    .movie-poster:hover {
        transform: scale(1.05);
    }

    .movie-info {
        max-width: 350px;
    }

    .screen-box {
        font-size: 20px;
        font-weight: bold;
        padding: 15px 30px;
        border-radius: 10px;
        background-color: #343a40;
        color: white;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    }

    .movie-poster {
        max-width: 200px;
        height: auto;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .movie-img-note {
        width: 100%;
        object-fit: cover;
        vertical-align: unset;
    }
    .screen {
        background: #444;
        color: white;
        padding: 10px;
        border-radius: 5px;
        font-weight: bold;
        text-align: center;
        width: 50%;
        margin: auto;
    }

    .screen-container {
        width: 50%;
    }

    .screen {
        font-size: 20px;
        font-weight: bold;
        background-color: #ddd;
        padding: 10px;
        border-radius: 5px;
        display: inline-block;
    }

    /* Thiết kế ghế */
    .seat {
        width: 40px;
        height: 40px;
        border-radius: 5px;
        text-align: center;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease-in-out;
        border: none;
        padding: 0;
    }

        .seat:hover {
            transform: scale(1.1);
            box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
        }

        .seat.available {
            background-color: #28a745;
            color: white;
        }

        .seat.reserved {
            background-color: #ffc107;
            color: black;
            cursor: not-allowed;
        }

        .seat.maintenance {
            background-color: #6c757d;
            color: white;
            cursor: not-allowed;
        }

        .seat.vip {
            background-color: #ff5733;
            color: white;
        }

        .seat.regular {
            background-color: #007bff;
            color: white;
        }

        .seat.couple {
            background-color: #e83e8c;
            color: white;
        }

        .seat.selected {
            background-color: #17a2b8;
            color: white;
        }

    /* Ghi chú ghế */
    .card {
        border-radius: 10px;
        overflow: hidden;
    }

    .seat-info {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
    }

    .seat-box {
        width: 20px;
        height: 20px;
        border-radius: 3px;
    }

        .seat-box.vip {
            background-color: #ff5733;
        }

        .seat-box.regular {
            background-color: #007bff;
        }

        .seat-box.couple {
            background-color: #e83e8c;
        }

        .seat-box.available {
            background-color: #28a745;
        }

        .seat-box.reserved {
            background-color: #ffc107;
        }

        .seat-box.maintenance {
            background-color: #6c757d;
        }

    .seat.reserved,
    .seat.maintenance {
        cursor: not-allowed;
        pointer-events: none;
    }

    #seatContainer {
        display: flex;
        flex-direction: column;
    }
    .seat-row {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 5px;
        gap: 7px;
    }

    .seat-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .reserved {
        background-color: red;
        cursor: not-allowed;
    }

</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
        let selectedSeats = [];
    let totalAmount = 0;

    $(document).ready(function () {
        // Chọn suất chiếu
        $('#showtimeSelect').change(function () {
            var showtimeId = $(this).val();
            $('#roomSelect').prop('disabled', false).empty().append('<option value="">🏠 Chọn phòng</option>');

            if (showtimeId) {
                $.get('/Booking/GetRooms', { showtimeId: showtimeId }, function (data) {
                    data.forEach(room => {
                        $('#roomSelect').append(`<option value="${room.roomId}">${room.roomName}</option>`);
                    });
                });
            }
        });

        // Chọn phòng
        $('#roomSelect').change(function () {
            var roomId = $(this).val();
            $('#seatContainer').empty();
            selectedSeats = [];
            totalAmount = 0;
            $('#totalAmount').text('0 đ');
            $('#confirmBooking').prop('disabled', true);

                if (roomId) {
                     var movieUrl = "https://e1.pngegg.com/pngimages/314/988/png-clipart-symbolize-x.png";
    var movieTitle = "@(movie?.Title ?? "Unknown")";
        $.get('/Booking/GetSeats', { roomId: roomId }, function (data) {
            let groupedSeats = {}; 

            data.forEach(seat => {
                let row = seat.seatNumber.charAt(0); 

                if (!groupedSeats[row]) {
                    groupedSeats[row] = [];
                }
                groupedSeats[row].push(seat);
            });

                Object.keys(groupedSeats).sort().forEach(row => {
        $('#seatContainer').append(`<div class="seat-row" id="row-${row}"><strong>${row}</strong></div>`);

        groupedSeats[row].sort((a, b) => parseInt(a.seatNumber.substring(1)) - parseInt(b.seatNumber.substring(1)))
            .forEach(seat => {
                let seatClass = 'available';
                let seatContent = `${seat.seatNumber}`;

                if (seat.seatType === 'VIP') seatClass = 'vip';
                if (seat.seatType === 'Regular') seatClass = 'regular';
                if (seat.seatType === 'Couple') seatClass = 'couple';
                if (seat.status === 'Reserved') {
                    seatClass = 'reserved';
                    seatContent = `<img src="${movieUrl}" class="seat-img">`;
                }
                if (seat.status === 'Maintenance') seatClass = 'maintenance';

                $(`#row-${row}`).append(`
                    <button class="seat ${seatClass}"
                            data-id="${seat.seatId}"
                            data-status="${seat.status}"
                            data-type="${seat.seatType}"
                            data-price="${seat.price}">
                        ${seatContent}
                    </button>
                `);
            });
    });

        });
    }
        });

        // Chọn ghế
        $(document).on('click', '.seat', function () {
            let seatId = $(this).data('id');
            let seatStatus = $(this).data('status');
            let seatPrice = parseFloat($(this).data('price')) || 0;

            if (seatStatus === 'Reserved' || seatStatus === 'Maintenance') {
                return;
            }

            if ($(this).hasClass('selected')) {
                $(this).removeClass('selected');
                selectedSeats = selectedSeats.filter(id => id !== seatId);
                totalAmount -= seatPrice;
            } else {
                $(this).addClass('selected');
                selectedSeats.push(seatId);
                totalAmount += seatPrice;
            }

            $('#totalAmount').text(totalAmount.toLocaleString() + ' đ');
            $('#confirmBooking').prop('disabled', selectedSeats.length === 0);
        });

        // Xử lý đặt vé
            $('#confirmBooking').click(function () {
        let selectedShowtime = $('#showtimeSelect').val();
        if (selectedSeats.length === 0) {
            alert("Vui lòng chọn ít nhất một ghế!");
            return;
        }

        $.ajax({
            url: '/CreatePayment',
            type: 'POST',
            contentType: "application/json",
            data: JSON.stringify({
                amount: totalAmount,
                seatIds: selectedSeats,
                showtimeId: selectedShowtime,
                customerId: 1
            }),
            success: function (response) {
                window.location.href = response.paymentUrl;
            },
            error: function (xhr) {
                alert("Lỗi: " + xhr.responseText);
            }
        });
    });

    });

</script>
